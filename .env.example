# -----------------------------------------------------------------------------
# Oratii AI Environment Variables Template
# Copy this file to .env.local and fill in your actual API keys.
# DO NOT commit .env or .env.local to GitHub or public version control.
# -----------------------------------------------------------------------------

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Service Providers (Fallback Waterfall)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
